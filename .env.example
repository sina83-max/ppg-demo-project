# ------------------------------------------------------------------ #
# PPG Demo – environment variables
# Copy to `.env`:  cp .env.example .env
# Switching between the mock and the real Jibit PPG only requires
# changing PPG_BASE_URL / PPG_API_KEY / PPG_SECRET_KEY (docs/AGENTS.md §11).
# ------------------------------------------------------------------ #

# --- Merchant -> PPG target ---------------------------------------- #
# Mock (default, local compose):
PPG_BASE_URL=http://mock-ppg:8001
PPG_API_KEY=mock-key
PPG_SECRET_KEY=mock-secret

# Real Jibit PPG (uncomment and fill in to switch, no code changes needed):
# PPG_BASE_URL=https://napi.jibit.ir/ppg
# PPG_API_KEY=your-real-api-key
# PPG_SECRET_KEY=your-real-secret-key

# --- Merchant application ------------------------------------------ #
# Base URL used to build callbackUrl. Inside Docker use the service name,
# outside Docker use http://localhost:8000.
MERCHANT_CALLBACK_BASE=http://localhost:8000
MERCHANT_PORT=8000
LOG_LEVEL=INFO

# Local run: relative path in merchant/. Docker: overridden to /data/merchant.db
DATABASE_URL=sqlite+aiosqlite:///./merchant.db

# --- Mock PPG ------------------------------------------------------ #
MOCK_PPG_PORT=8001
MOCK_LOG_LEVEL=INFO
# 0.0 = never answer UNKNOWN, 0.3 = ~30% of verifies return UNKNOWN (demo of retry logic)
MOCK_UNKNOWN_ANSWER_RATE=0.0

# Browser-facing base of the mock; used to build pspSwitchingUrl.
# Must be reachable from the browser, not from inside Docker.
MOCK_PUBLIC_BASE_URL=http://localhost:8001

# Host rewrite applied to the merchant's callbackUrl before the mock posts it.
# The merchant sends http://localhost:8000, which is unreachable from inside the
# mock container, so Docker rewrites it to the service name. Set to empty to
# disable the rewrite (e.g. when the mock runs outside Docker).
MOCK_CALLBACK_BASE_URL_OVERRIDE=http://merchant:8000

# Local run: relative path in mock_ppg/. Docker: overridden to /data/mock_ppg.db
MOCK_DATABASE_URL=sqlite+aiosqlite:///./mock_ppg.db
